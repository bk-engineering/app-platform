# ---- postgres ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_platform
POSTGRES_PORT=5432

# ---- redis ----
REDIS_PORT=6379

# ---- api (apps/api) ----
API_PORT=4000
DATABASE_URL=postgresql://app:app@postgres:5432/app_platform?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
LOG_LEVEL=debug
CORS_ORIGINS=http://app.localhost
APP_WEB_URL=http://app.localhost
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password

# ---- web (apps/web) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://api.localhost

# ---- docs (apps/docs) ----
DOCS_PORT=5173

# ---- traefik ----
TRAEFIK_DASHBOARD_PORT=8080
