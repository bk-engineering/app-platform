# the sandbox this repo sometimes builds in has a slow/flaky path to registry.npmjs.org —
# pnpm's 60s default fetch-timeout aborts mid-download on large packages (turbo, @prisma/*,
# @electric-sql/pglite) before they finish at ~30-50 KiB/s. Lower concurrency so the
# available bandwidth isn't split as thin, and give each request more time before giving up.
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=90000
network-concurrency=6
